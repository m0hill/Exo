        "v": { "$ref": "#/$defs/VersionField" }
      },
      "required": ["type", "target", "node"],
      "additionalProperties": false
    },

    "ClipboardWriteMsg": {
      "type": "object",
      "properties": {
        "type": { "const": "clipboard" },
