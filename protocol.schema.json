    "EventConfigAck": {
      "type": "object",
      "properties": {
        "type": { "const": "event" },
        "name": { "const": "config_ack" },
        "applied": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rejected": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConfigAckRejected" }
        },
        "v": { "$ref": "#/$defs/VersionField" }
      },
      "required": ["type", "name", "applied", "rejected"],
      "additionalProperties": false
    },

    "EventRendered": {
      "type": "object",
      "properties": {
        "type": { "const": "event" },
