{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exo:tui:protocol:v1",
  "title": "Exo TUI JSONL Protocol (v1)",
  "$ref": "#/$defs/Msg",
  "$defs": {
    "Msg": {
      "oneOf": [
        { "$ref": "#/$defs/PatchMsgFull" },
        { "$ref": "#/$defs/PatchMsgTarget" },
        { "$ref": "#/$defs/EventMsg" },
        { "$ref": "#/$defs/ClipboardWriteMsg" },
        { "$ref": "#/$defs/ClipboardReadMsg" },
        { "$ref": "#/$defs/ConfigMsg" }
      ]
    },

    "VersionField": {
      "type": "integer",
      "const": 1
    },

    "ThemeName": {
      "type": "string",
      "enum": ["default", "light", "ocean"]
    },

    "ValidationState": {
      "type": "string",
      "enum": ["none", "error", "warning", "success"]
    },

    "StateMode": {
      "type": "string",
      "enum": ["uncontrolled", "init", "controlled"]
    },

    "ListMarker": {
      "type": "string",
      "enum": ["default", "none"]
    },

    "JustifyContent": {
      "type": "string",
      "enum": ["start", "center", "end", "space_between", "space_around", "space_evenly"]
    },

    "AlignItems": {
      "type": "string",
      "enum": ["start", "center", "end", "stretch"]
    },

    "HorizontalAlign": {
      "type": "string",
      "enum": ["left", "center", "right"]
    },

    "VerticalAlign": {
      "type": "string",
      "enum": ["top", "center", "bottom"]
    },

    "OverlayPlacement": {
      "type": "string",
      "enum": ["below", "above", "right", "left", "center"]
    },

    "OverlayAlign": {
      "type": "string",
      "enum": ["start", "center", "end"]
    },

    "PointerKind": {
      "type": "string",
      "enum": ["down", "up", "move", "drag", "scroll"]
    },

    "PointerButton": {
      "type": "string",
      "enum": ["left", "middle", "right", "none"]
    },

    "ClipboardOp": {
      "type": "string",
      "enum": ["write", "read"]
    },

    "PasteSource": {
      "type": "string",
      "enum": ["bracketed", "clipboard"]
    },

    "KeyAction": {
      "type": "string",
      "enum": [
        "noop",
        "focus_next",
        "focus_prev",
        "focus_scope_next",
        "focus_scope_prev",
        "focus_clear",
        "list_prev",
        "list_next",
        "list_activate",
        "scroll_line_up",
        "scroll_line_down",
        "scroll_page_up",
        "scroll_page_down",
        "scroll_home",
        "scroll_end",
        "action_activate",
        "input_left",
        "input_right",
        "input_word_left",
        "input_word_right",
        "input_home",
        "input_end",
        "input_delete",
        "input_backspace",
        "input_select_left",
        "input_select_right",
        "input_select_word_left",
        "input_select_word_right",
        "input_select_home",
        "input_select_end",
        "input_select_all",
        "input_copy",
        "input_paste",
        "input_undo",
        "input_redo",
        "textarea_left",
        "textarea_right",
        "textarea_up",
        "textarea_down",
        "textarea_word_left",
        "textarea_word_right",
        "textarea_home",
        "textarea_end",
        "textarea_page_up",
        "textarea_page_down",
        "textarea_delete",
        "textarea_backspace",
        "textarea_newline",
        "textarea_select_left",
        "textarea_select_right",
        "textarea_select_up",
        "textarea_select_down",
        "textarea_select_word_left",
        "textarea_select_word_right",
        "textarea_select_home",
        "textarea_select_end",
        "textarea_select_all",
        "textarea_copy",
        "textarea_paste",
        "textarea_undo",
        "textarea_redo"
      ]
    },

    "IdString": {
      "type": "string",
      "minLength": 1
    },

    "StyleOverride": {
      "type": "object",
      "properties": {
        "fg": {
          "oneOf": [
            { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|[A-Za-z][A-Za-z0-9]*)$" },
            { "type": "null" }
          ]
        },
        "bg": {
          "oneOf": [
            { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|[A-Za-z][A-Za-z0-9]*)$" },
            { "type": "null" }
          ]
        },
        "bold": { "type": "boolean" },
        "dim": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "blink": { "type": "boolean" },
        "inverse": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "strikethrough": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "NodeArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/Node" }
    },

    "GridTrack": {
      "description": "Canonical grid track: integer fixed, \"auto\", or \"<n>fr\". 0fr is syntactically valid but not meaningful.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "const": "auto" },
        { "type": "string", "pattern": "^[0-9]+fr$" }
      ]
    },

    "OverlayLayer": {
      "type": "object",
      "properties": {
        "node": { "$ref": "#/$defs/Node" },
        "anchor": { "type": "string" },
        "placement": { "$ref": "#/$defs/OverlayPlacement" },
        "align": { "$ref": "#/$defs/OverlayAlign" },
        "offset_x": { "type": "integer" },
        "offset_y": { "type": "integer" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "clip": { "type": "boolean" },
        "modal": { "type": "boolean" }
      },
      "required": ["node", "placement"],
      "additionalProperties": false
    },

    "Span": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" }
      },
      "required": ["text"],
      "additionalProperties": false
    },

    "Node": {
      "oneOf": [
        { "$ref": "#/$defs/NodeVBox" },
        { "$ref": "#/$defs/NodeHBox" },
        { "$ref": "#/$defs/NodeGrid" },
        { "$ref": "#/$defs/NodeBox" },
        { "$ref": "#/$defs/NodeScroll" },
        { "$ref": "#/$defs/NodeOverlay" },
        { "$ref": "#/$defs/NodeText" },
        { "$ref": "#/$defs/NodeStyledText" },
        { "$ref": "#/$defs/NodeInput" },
        { "$ref": "#/$defs/NodeTextarea" },
        { "$ref": "#/$defs/NodeList" }
      ]
    },

    "NodeVBox": {
      "type": "object",
      "properties": {
        "type": { "const": "vbox" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "pad": { "type": "integer", "minimum": 0 },
        "clip": { "type": "boolean" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "justify_content": { "$ref": "#/$defs/JustifyContent" },
        "align_items": { "$ref": "#/$defs/AlignItems" },
        "gap": { "type": "integer", "minimum": 0 },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "children": { "$ref": "#/$defs/NodeArray" }
      },
      "required": ["type", "id", "children"],
      "additionalProperties": false
    },

    "NodeHBox": {
      "type": "object",
      "properties": {
        "type": { "const": "hbox" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "pad": { "type": "integer", "minimum": 0 },
        "clip": { "type": "boolean" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "justify_content": { "$ref": "#/$defs/JustifyContent" },
        "align_items": { "$ref": "#/$defs/AlignItems" },
        "gap": { "type": "integer", "minimum": 0 },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "children": { "$ref": "#/$defs/NodeArray" }
      },
      "required": ["type", "id", "children"],
      "additionalProperties": false
    },

    "NodeGrid": {
      "type": "object",
      "properties": {
        "type": { "const": "grid" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "pad": { "type": "integer", "minimum": 0 },
        "clip": { "type": "boolean" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "gap_x": { "type": "integer", "minimum": 0 },
        "gap_y": { "type": "integer", "minimum": 0 },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridTrack" }
        },
        "cols": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridTrack" }
        },
        "areas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "children": { "$ref": "#/$defs/NodeArray" }
      },
      "required": ["type", "id", "rows", "cols", "children"],
      "additionalProperties": false
    },

    "NodeBox": {
      "type": "object",
      "properties": {
        "type": { "const": "box" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "border": { "type": "boolean" },
        "pad": { "type": "integer", "minimum": 0 },
        "clip": { "type": "boolean" },
        "shadow": { "type": "boolean" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "child": { "$ref": "#/$defs/Node" }
      },
      "required": ["type", "id", "child"],
      "additionalProperties": false
    },

    "NodeScroll": {
      "type": "object",
      "properties": {
        "type": { "const": "scroll" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "pad": { "type": "integer", "minimum": 0 },
        "clip": { "type": "boolean" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "state_mode": { "$ref": "#/$defs/StateMode" },
        "scroll_y": { "type": "integer", "minimum": 0 },
        "child": { "$ref": "#/$defs/Node" }
      },
      "required": ["type", "id", "child"],
      "additionalProperties": false
    },

    "NodeOverlay": {
      "type": "object",
      "properties": {
        "type": { "const": "overlay" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "pad": { "type": "integer", "minimum": 0 },
        "clip": { "type": "boolean" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "base": { "$ref": "#/$defs/Node" },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/OverlayLayer" }
        }
      },
      "required": ["type", "id", "base", "layers"],
      "additionalProperties": false
    },

    "NodeText": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "ext_align": { "$ref": "#/$defs/HorizontalAlign" },
        "v_align": { "$ref": "#/$defs/VerticalAlign" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "text": { "type": "string" }
      },
      "required": ["type", "id", "text"],
      "additionalProperties": false
    },

    "NodeStyledText": {
      "type": "object",
      "properties": {
        "type": { "const": "styled_text" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "ext_align": { "$ref": "#/$defs/HorizontalAlign" },
        "v_align": { "$ref": "#/$defs/VerticalAlign" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/Span" }
        }
      },
      "required": ["type", "id", "spans"],
      "additionalProperties": false
    },

    "NodeInput": {
      "type": "object",
      "properties": {
        "type": { "const": "input" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "content_align": { "$ref": "#/$defs/HorizontalAlign" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "selection_style": { "$ref": "#/$defs/StyleOverride" },
        "placeholder_style": { "$ref": "#/$defs/StyleOverride" },
        "placeholder": { "type": "string" },
        "state_mode": { "$ref": "#/$defs/StateMode" },
        "value": { "type": "string" },
        "cursor": { "type": "integer", "minimum": 0 },
        "scroll_x": { "type": "integer", "minimum": 0 },
        "selection_start": { "type": "integer", "minimum": 0 },
        "selection_end": { "type": "integer", "minimum": 0 }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },

    "NodeTextarea": {
      "type": "object",
      "properties": {
        "type": { "const": "textarea" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "selection_style": { "$ref": "#/$defs/StyleOverride" },
        "placeholder_style": { "$ref": "#/$defs/StyleOverride" },
        "placeholder": { "type": "string" },
        "state_mode": { "$ref": "#/$defs/StateMode" },
        "value": { "type": "string" },
        "cursor": { "type": "integer", "minimum": 0 },
        "scroll_y": { "type": "integer", "minimum": 0 },
        "selection_start": { "type": "integer", "minimum": 0 },
        "selection_end": { "type": "integer", "minimum": 0 }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },

    "NodeList": {
      "type": "object",
      "properties": {
        "type": { "const": "list" },
        "id": { "$ref": "#/$defs/IdString" },
        "class": { "type": "string" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "flex": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "align_self": { "$ref": "#/$defs/AlignItems" },
        "hoverable": { "type": "boolean" },
        "mouseable": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/ValidationState" },
        "focusable": { "type": "boolean" },
        "focus_scope": { "$ref": "#/$defs/IdString" },
        "marker": { "$ref": "#/$defs/ListMarker" },
        "grid_row": { "type": "integer", "minimum": 0 },
        "grid_col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "grid_area": { "type": "string" },
        "style": { "$ref": "#/$defs/StyleOverride" },
        "state_mode": { "$ref": "#/$defs/StateMode" },
        "selected_id": { "type": "string" },
        "scroll": { "type": "integer", "minimum": 0 },
        "children": { "$ref": "#/$defs/NodeArray" }
      },
      "required": ["type", "id", "children"],
      "additionalProperties": false
    },

    "PatchMsgFull": {
      "type": "object",
      "properties": {
        "type": { "const": "patch" },
