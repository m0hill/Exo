        "seq": { "type": "integer", "minimum": 0 },
        "v": { "$ref": "#/$defs/VersionField" }
      },
      "required": ["type"],
      "anyOf": [
        { "required": ["keybindings"] },
        { "required": ["theme"] }
      ],
      "additionalProperties": false
    },

    "EventMsg": {
      "oneOf": [
        { "$ref": "#/$defs/EventHello" },
