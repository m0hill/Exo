          "type": "string",
          "enum": [
            "queued",
            "coalesced",
            "applied",
            "dropped_overflow",
            "dropped_stale",
            "dropped_no_root",
            "dropped_not_found",
            "ignored_invalid"
          ]
        },
        "detail": { "type": "string" },
        "v": { "$ref": "#/$defs/VersionField" }
      },
      "required": ["type", "name", "seq", "status"],
      "additionalProperties": false
    },

    "ConfigAckRejected": {
      "type": "object",
