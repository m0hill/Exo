        "bracketed_paste": { "type": "boolean" },
        "mouse_sgr": { "type": "boolean" },
        "osc52": { "type": "boolean" },
        "color": {
          "type": "string",
          "enum": ["mono", "ansi16", "ansi256", "truecolor"]
