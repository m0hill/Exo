      },
      "required": ["type", "name", "seq"],
      "additionalProperties": false
    },

    "EventDropped": {
      "type": "object",
      "properties": {
        "type": { "const": "event" },
        "name": { "const": "dropped" },
        "seq": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 },
        "v": { "$ref": "#/$defs/VersionField" }
      },
      "required": ["type", "name", "seq", "reason"],
      "additionalProperties": false
    }
