          "maximum": 7
        },
        "action": { "$ref": "#/$defs/KeyAction" }
      },
      "required": ["key", "action"],
      "additionalProperties": false
    },

    "KeybindingsConfig": {
      "type": "object",
      "properties": {
        "global": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeybindingRule" }
        },
        "input": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeybindingRule" }
        },
        "textarea": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeybindingRule" }
        },
        "list": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeybindingRule" }
        },
        "scroll": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeybindingRule" }
        },
        "action": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeybindingRule" }
        }
      },
      "additionalProperties": false
    },

    "ConfigMsg": {
      "type": "object",
      "properties": {
        "type": { "const": "config" },
        "keybindings": { "$ref": "#/$defs/KeybindingsConfig" },
