        { "$ref": "#/$defs/EventActivate" },
        { "$ref": "#/$defs/EventScroll" },
        { "$ref": "#/$defs/EventResize" },
        { "$ref": "#/$defs/EventHover" },
        { "$ref": "#/$defs/EventSelection" },
        { "$ref": "#/$defs/EventPointer" },
        { "$ref": "#/$defs/EventClipboard" },
        { "$ref": "#/$defs/EventPaste" },
        { "$ref": "#/$defs/EventError" },
        { "$ref": "#/$defs/EventAck" },
        { "$ref": "#/$defs/EventConfigAck" },
        { "$ref": "#/$defs/EventRendered" },
        { "$ref": "#/$defs/EventDropped" }
      ]
    },

