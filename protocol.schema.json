        "data": { "type": "string" },
        "target": {
          "type": "string",
          "enum": ["clipboard"]
        },
        "seq": { "type": "integer", "minimum": 0 },
        "v": { "$ref": "#/$defs/VersionField" }
      },
      "required": ["type", "op", "data"],
      "additionalProperties": false
    },

    "ClipboardReadMsg": {
      "type": "object",
